APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_DB=support_copilot
POSTGRES_USER=support_user
POSTGRES_PASSWORD=support_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT_SECONDS=5

REDIS_PORT=6379

OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_TIMEOUT_SECONDS=120
ROUTER_MODEL=qwen3:4b
EVIDENCE_ASSESSOR_MODEL=qwen3:4b
MAIN_MODEL=qwen3:14b
ESCALATION_MODEL=qwen3:20b

RETRIEVAL_CONFIDENCE_THRESHOLD=0.55
ANSWER_CONFIDENCE_THRESHOLD=0.65

PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-now

LOG_LEVEL=INFO
LLM_PROVIDER=ollama
OLLAMA_TIMEOUT_SECONDS=480

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_IDEMPOTENCY_TTL_SECONDS=900